# ============================================================================
# Domain
# ============================================================================

# Production domain (Traefik routing + TLS certificates)
DOMAIN=localhost
# DOMAIN=localhost.example.com

# Backend uses this for frontend links (emails, redirects, etc.)
FRONTEND_HOST=http://localhost:3000
# FRONTEND_HOST=https://app.example.com

# Available values: local | staging | production
ENVIRONMENT=local

PROJECT_NAME=hirerank
STACK_NAME=hirerank-local

# ============================================================================
# Backend
# ============================================================================

BACKEND_CORS_ORIGINS="http://localhost,http://localhost:3000,https://localhost,https://localhost:3000"

SECRET_KEY=change-me-to-a-long-random-string

# Access token TTL (minutes) / refresh TTL (days)
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Soft-revoke window after refresh rotation (seconds)
REFRESH_TOKEN_GRACE_SECONDS=20

# Hidden multi-tenancy (Core): one enterprise per deploy
TENANT_ID=00000000-0000-4000-8000-000000000001
TENANT_SLUG=default
TENANT_NAME=Default
# memory | redis
# Core / single-instance self-host: memory (default, zero-ops)
# Enterprise multi-replica or SaaS: redis (shared sessions)
TOKEN_STORE=memory

FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changeme

# ============================================================================
# Email
# ============================================================================

SMTP_HOST=mailcatcher
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@example.com

SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=1025

# ============================================================================
# Database (Postgres)
# ============================================================================

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hirerank
POSTGRES_USER=hirerank
POSTGRES_PASSWORD=changeme
# Dedicated database for n8n (do not reuse the app DB — schema conflicts)
POSTGRES_N8N_DB=n8n

# Async SQLAlchemy engine (postgresql+asyncpg). URI is derived from POSTGRES_*.
# queue = production pool; null = no pooling (tests / one-off scripts)
SQLALCHEMY_ECHO=False
SQLALCHEMY_POOL_MODE=queue
SQLALCHEMY_POOL_SIZE=20
SQLALCHEMY_MAX_OVERFLOW=10
# Recycle connections before DB/proxy idle timeouts (seconds)
SQLALCHEMY_POOL_RECYCLE=1800

# ============================================================================
# Redis
# ============================================================================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=changeme

# ============================================================================
# Object Storage (MinIO)
# ============================================================================

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_BUCKET_NAME=hirerank

# ============================================================================
# N8N
# ============================================================================

N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key
N8N_USER_MANAGEMENT_JWT_SECRET=change-me-n8n-jwt-secret
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# ============================================================================
# Frontend (build-time)
# ============================================================================

# Frontend → FastAPI
NEXT_PUBLIC_API_URL=http://localhost:8000

# Cookie session (local HTTP → COOKIE_SECURE=false; production forces Secure)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
AUTH_COOKIE_HOST_PREFIX=false

# Social OAuth (identity only; session is HireRank JWT cookies)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback/google
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback/linkedin
# Optional Fernet key; empty → derived from SECRET_KEY
OAUTH_TOKEN_ENCRYPTION_KEY=

# ============================================================================
# Monitoring
# ============================================================================

SENTRY_DSN=

# ============================================================================
# Docker Images
# ============================================================================

DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend
