# ============================================================================
# Domain
# ============================================================================

# Production domain (Traefik routing + TLS certificates)
DOMAIN=localhost
# DOMAIN=localhost.example.com

# Backend uses this for frontend links (emails, redirects, etc.)
FRONTEND_HOST=http://localhost:3000
# FRONTEND_HOST=https://app.example.com

# Available values: local | staging | production
ENVIRONMENT=local

PROJECT_NAME=hirerank
STACK_NAME=hirerank-local

# ============================================================================
# Backend
# ============================================================================

BACKEND_CORS_ORIGINS="http://localhost,http://localhost:3000,https://localhost,https://localhost:3000"

SECRET_KEY=change-me-to-a-long-random-string

# Access token TTL (minutes) / refresh TTL (days)
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Hidden multi-tenancy (Core): one enterprise per deploy
TENANT_ID=00000000-0000-4000-8000-000000000001
TENANT_SLUG=default
TENANT_NAME=Default
# memory | redis — use memory only for local unit tests without Redis
TOKEN_STORE=redis

FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changeme

# ============================================================================
# Email
# ============================================================================

SMTP_HOST=mailcatcher
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@example.com

SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=1025

# ============================================================================
# Database (Postgres)
# ============================================================================

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hirerank
POSTGRES_USER=hirerank
POSTGRES_PASSWORD=changeme
# Dedicated database for n8n (do not reuse the app DB — schema conflicts)
POSTGRES_N8N_DB=n8n

# ============================================================================
# Redis
# ============================================================================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=changeme

# ============================================================================
# Object Storage (MinIO)
# ============================================================================

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_BUCKET_NAME=hirerank

# ============================================================================
# N8N
# ============================================================================

N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key
N8N_USER_MANAGEMENT_JWT_SECRET=change-me-n8n-jwt-secret
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# ============================================================================
# Frontend (build-time)
# ============================================================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ============================================================================
# Monitoring
# ============================================================================

SENTRY_DSN=

# ============================================================================
# Docker Images
# ============================================================================

DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend
