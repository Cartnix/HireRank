{
  "openapi": "3.1.0",
  "info": {
    "title": "HireRank Copilot frontend mock API",
    "version": "0.1.0",
    "description": "Proposed interface only. These routes are not implemented by the backend."
  },
  "paths": {
    "/copilot/candidates": {
      "get": {
        "summary": "Tenant candidate pool",
        "responses": {
          "200": {
            "description": "Candidates",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CandidateSchema"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Intake triggers AI draft",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CandidateSchema"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Mock result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CandidateSchema"
                }
              }
            }
          }
        }
      }
    },
    "/copilot/vacancies": {
      "get": {
        "summary": "Tenant vacancies",
        "responses": {
          "200": {
            "description": "Vacancies",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/VacancySchema"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "HR/admin vacancy",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VacancySchema"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Mock result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VacancySchema"
                }
              }
            }
          }
        }
      }
    },
    "/copilot/evaluations": {
      "get": {
        "summary": "HR drafts",
        "responses": {
          "200": {
            "description": "Drafts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EvaluationSchema"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/copilot/evaluations/{id}/confirm": {
      "post": {
        "summary": "HR approval, then MCP action",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "review",
                      "interview",
                      "rejected"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mock result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/McpRunSchema"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden"
          },
          "409": {
            "description": "Already confirmed"
          }
        }
      }
    },
    "/copilot/prompts": {
      "get": {
        "summary": "HR rules",
        "responses": {
          "200": {
            "description": "Mock result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PromptSchema"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Configure HR rules",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PromptSchema"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mock result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PromptSchema"
                }
              }
            }
          }
        }
      }
    },
    "/copilot/feedback": {
      "post": {
        "summary": "Manager proposal",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackSchema"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Mock result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedbackSchema"
                }
              }
            }
          }
        }
      }
    },
    "/copilot/notifications": {
      "get": {
        "summary": "Role-scoped notifications",
        "responses": {
          "200": {
            "description": "Notifications",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/NotificationSchema"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/copilot/memory": {
      "get": {
        "summary": "Opt-in Markdown memory",
        "responses": {
          "200": {
            "description": "Records",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MemorySchema"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Confirmed HR memory",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemorySchema"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Mock result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemorySchema"
                }
              }
            }
          }
        }
      }
    },
    "/copilot/audit": {
      "get": {
        "summary": "Tenant audit",
        "responses": {
          "200": {
            "description": "Events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AuditSchema"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
