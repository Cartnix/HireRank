{
  "name": "hirerank",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "generate:api-types": "openapi-typescript ../contracts/generated/backend/openapi.json -o ../contracts/generated/frontend/api.d.ts && cp ../contracts/generated/frontend/api.d.ts shared/api/schema.d.ts",
    "openapi:check": "openapi-typescript ../contracts/generated/backend/openapi.json -o /tmp/hirerank-schema-check.d.ts",
    "contracts:export:backend": "docker compose run --rm --no-deps -v \"$PWD/../contracts:/app/contracts\" backend python -m scripts.export_contracts",
    "contracts:export:frontend": "tsx scripts/export-contracts.ts",
    "contracts:export": "npm run contracts:export:backend && npm run contracts:export:frontend && npm run generate:api-types",
    "contracts:check": "npm run contracts:export && git -C .. diff --exit-code -- contracts/generated frontend/shared/api/schema.d.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.21.0",
    "motion": "^12.40.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.54.2",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "zod-to-json-schema": "^3.25.2"
  }
}
